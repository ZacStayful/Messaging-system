# Copy to .env.local and fill in. Every variable is documented in README.md.
# Never commit .env.local — .gitignore covers it.

# ---- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Used by the notification cron, unsubscribe links, the inbound
# email webhook, and API-key lookup. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Public API and MCP server ----------------------------------------------
# Required by /api/v1 and /api/mcp: each request is signed as the API key's user
# so that RLS applies unchanged. Supabase dashboard → Project Settings → JWT Keys
# → Legacy JWT Secret → Reveal. Without it both answer 503 rather than failing
# obscurely.
#
# Do NOT click "Migrate JWT secret" or rotate keys on that page: requests are
# signed HS256 with this secret, so moving to asymmetric signing keys (or
# rotating/revoking) stops the API and MCP server at once with 401s.
SUPABASE_JWT_SECRET=

# ---- Email (Resend) ---------------------------------------------------------
# Without RESEND_API_KEY accounts are still created, but the generated password
# is shown to the team member instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=Stayful <noreply@stayful.co.uk>

# Random string. Vercel sends it to the cron route; it also signs unsubscribe links.
CRON_SECRET=

# Optional. Reply-by-email: the subdomain with MX at Resend, and the webhook secret.
EMAIL_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=

# ---- Tests ------------------------------------------------------------------
# The password given to the two seeded *@stayful.test accounts. The RLS suite
# and the Playwright sign-in specs skip without it. Never point these at
# production, which holds real accounts only.
SEED_TEST_PASSWORD=
