# Copy to .env.local and fill in. Every variable is documented in README.md.
# Never commit .env.local — .gitignore covers it.

# ---- Supabase (required) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Used by the notification cron, unsubscribe links, the inbound
# email webhook, and API-key lookup. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Public API and MCP server ----------------------------------------------
# Required by /api/v1 and /api/mcp: each request is signed as the API key's user
# so that RLS applies unchanged. Supabase dashboard → Project Settings → JWT Keys
# → Legacy JWT Secret → Reveal. Without it both answer 503 rather than failing
# obscurely.
#
# Do NOT click "Migrate JWT secret" or rotate keys on that page: requests are
# signed HS256 with this secret, so moving to asymmetric signing keys (or
# rotating/revoking) stops the API and MCP server at once with 401s.
SUPABASE_JWT_SECRET=

# ---- Email (Resend) ---------------------------------------------------------
# Without RESEND_API_KEY accounts are still created, but the generated password
# is shown to the team member instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=Stayful <noreply@stayful.co.uk>

# Random string. Vercel sends it to the cron route; it also signs unsubscribe links.
CRON_SECRET=

# Optional. Reply-by-email: the subdomain with MX at Resend, and the webhook secret.
EMAIL_REPLY_DOMAIN=
RESEND_WEBHOOK_SECRET=

# ---- WhatsApp (TimelinesAI) -------------------------------------------------
# The public API token (https://timelines.ai/docs). NOTE this is load-bearing for
# sign-in, not just notifications: the first-login gate sends its verification
# code over WhatsApp. Without it, customers without a number are offered "Skip
# for now" rather than being locked out.
TIMELINES_API_TOKEN=

# Optional fallback only. Which number a message sends from is decided by the
# customer group's whatsapp_accounts row (0022), not by this. It is used when a
# group has no number assigned at all.
TIMELINES_WHATSAPP_ACCOUNT_ID=

# Optional. Override the API base, e.g. to point at a local stub in tests.
TIMELINES_API_BASE=

# Local and test only. "1" makes every send succeed without a request, so the
# notification drain and the gate can be exercised offline.
TIMELINES_DRY_RUN=

# The secret in the inbound webhook URL. Register the webhook in TimelinesAI as
# https://chat.stayful.co.uk/api/whatsapp/inbound/<this value>. TimelinesAI
# publishes no signature scheme, so a long random path segment is the gate.
WHATSAPP_WEBHOOK_TOKEN=

# Optional second factor: when set, an x-stayful-token header must match too.
# Only usable if the TimelinesAI dashboard can send custom webhook headers.
WHATSAPP_WEBHOOK_SECRET=

# Optional. Caps WhatsApp sends per cron run (default 60). WhatsApp does not
# batch, so this is what stands between a busy morning and a flagged number.
WHATSAPP_MAX_PER_RUN=

# ---- Tests ------------------------------------------------------------------
# The password given to the two seeded *@stayful.test accounts. The RLS suite
# and the Playwright sign-in specs skip without it. Never point these at
# production, which holds real accounts only.
SEED_TEST_PASSWORD=

# --- Monday.com (Clients board -> customer group + property group) -----------
# The integration ships switched OFF. Turn it on at Settings -> Integrations once these are set
# and Monday is pointed at the webhook; until then deliveries are received, logged and ignored.

# Secret path segment of the inbound webhook URL, exactly like WHATSAPP_WEBHOOK_TOKEN. Monday's
# board-level webhook recipes send an unsigned POST, so this is what authenticates it.
# Register: https://chat.stayful.co.uk/api/monday/webhook/<MONDAY_WEBHOOK_TOKEN>
MONDAY_WEBHOOK_TOKEN=

# Optional second factor: when set, an x-stayful-token header must match too.
MONDAY_WEBHOOK_SECRET=

# Monday API token (Admin -> API). Read-only use: a create_item webhook carries the item id and
# little else, so the property address has to be fetched off the item.
MONDAY_API_TOKEN=

# The Clients board. Defaults to 4972230367; an event from any other board is logged and ignored.
MONDAY_CLIENTS_BOARD_ID=

# ---- Calling (Twilio) ----
# A team member talks in the browser; Twilio dials the contact's mobile. All six are required —
# callsConfigured() hides the Call button entirely rather than showing a control that throws.
#
# The auth token and the API key are not alternatives. The auth token is the only thing that can
# verify a webhook really came from Twilio (it signs them); an API key is the only thing that can
# sign a browser access token. Both, or neither works.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# The TwiML App the browser SDK dials through. Its Voice URL points at
# /api/twilio/voice/<TWILIO_WEBHOOK_TOKEN>.
TWILIO_TWIML_APP_SID=
# Secret path segment of every Twilio webhook URL, the same idea as WHATSAPP_WEBHOOK_TOKEN.
# Invent it; Twilio never issues one. Unlike TimelinesAI, Twilio also signs its requests, so this
# is a second layer rather than the whole lock.
TWILIO_WEBHOOK_TOKEN=
# "1" composes every call and places none. The TIMELINES_DRY_RUN idea, for voice.
TWILIO_DRY_RUN=

# There is no TWILIO_CALLER_ID: the number a call goes out from is a row in voice_numbers (0032),
# so giving each account manager their own number later is a row rather than a deploy.
